{
	"name": "11gather11-com",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		// src/ssg writes every page as dir/index.html; this serves it at /dir/ and redirects /dir there.
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
	},
	"routes": [
		{
			"pattern": "11gather11.com",
			"custom_domain": true,
		},
	],
	// The site is only served on its own domain; a workers.dev copy would be duplicate content.
	"workers_dev": false,
	"preview_urls": false,
}
